<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources. The Fuaran.Core packages this repository pins are released on nuget.org, and
  that is where an outside clone restores them. The `local` folder feed is the development loop's:
  a fresh pack there shadows a released package at the same version, which is why it is declared
  first. It resolves relative to this file, one level above the repository's parent directory; CI
  mints an empty directory at that path before restore, because NuGet refuses a missing folder
  source (NU1301) rather than treating it as empty. Forward slashes for Linux portability.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../local-nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Fuaran.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Fuaran.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
