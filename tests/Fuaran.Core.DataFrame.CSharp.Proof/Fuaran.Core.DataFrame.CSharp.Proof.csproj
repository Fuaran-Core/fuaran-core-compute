<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fuaran.Core.CSharp.Proof</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The dataframe half of the facade proves its own coverage over its own assembly. The legs
         that are not about either half of the facade (the check ledger, the coverage walk, the
         surface rule and its decoys) and the column-layer halves of the partial generator and
         rebuild walk live in the Fuaran.Core repository's facade proof, which proves the other
         half; they travelled here as COPIES under Shared/ (Phase 259), declared in copies.json so
         a drift between the two is named. The default compile glob picks them up. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Core.DataFrame.CSharp\Fuaran.Core.DataFrame.CSharp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- `ConfRng`, as in the substrate's facade proof: the seeded, Fable-identical draw stream. -->
    <PackageReference Include="Fuaran.Core.Conformance" />
  </ItemGroup>
</Project>
