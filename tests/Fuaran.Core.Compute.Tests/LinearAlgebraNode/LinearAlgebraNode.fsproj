<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Phase 590 - the node leg of the linear-algebra package: `linearAlgebraLaws` and the hard-input law
    vectors (../LinearAlgebraVectors.fs) under the JavaScript host. Not a member of the solution: the
    suite's LinearAlgebraTests compiles it with Fable (the version the repository's tool manifest pins)
    into a scratch directory, runs the emitted LinearAlgebraNode.js under node, and holds the document
    it prints to the committed conformance/laws/linear-algebra-laws.json byte for byte. Since Phase 630 it
    runs the elementary package's laws and vectors (../ElementaryVectors.fs) too, held to
    conformance/laws/elementary-laws.json the same way, and since Phase 632 the regression package's
    (../RegressionVectors.fs), held to conformance/laws/regression-laws.json, and since Phase 633 the
    solvers package's (../SolversVectors.fs), held to conformance/laws/solvers-laws.json.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ElementaryVectors.fs" Link="ElementaryVectors.fs" />
    <!-- Phase 631: the special functions' vectors, the rest of the elementary document. -->
    <Compile Include="..\SpecialVectors.fs" Link="SpecialVectors.fs" />
    <Compile Include="..\LinearAlgebraVectors.fs" Link="LinearAlgebraVectors.fs" />
    <Compile Include="..\RegressionVectors.fs" Link="RegressionVectors.fs" />
    <Compile Include="..\SolversVectors.fs" Link="SolversVectors.fs" />
    <Compile Include="LinearAlgebraNode.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Fuaran.Compute.Solvers\Fuaran.Compute.Solvers.fsproj" />
    <ProjectReference Include="..\..\..\src\Fuaran.Compute.Elementary\Fuaran.Compute.Elementary.fsproj" />
    <ProjectReference Include="..\..\..\src\Fuaran.Compute.LinearAlgebra\Fuaran.Compute.LinearAlgebra.fsproj" />
    <ProjectReference Include="..\..\..\src\Fuaran.Compute.Regression\Fuaran.Compute.Regression.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- The one corpus writer the vector file is rendered through. -->
    <PackageReference Include="Fuaran.Core.Conformance" />
    <PackageReference Include="Fuaran.Core.Wire" />
    <PackageReference Include="Fuaran.Core.Column" />
  </ItemGroup>
</Project>
