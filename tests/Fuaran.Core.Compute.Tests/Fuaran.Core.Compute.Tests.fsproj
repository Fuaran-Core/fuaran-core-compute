<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The repository root, the UTF-8 child-process reader, the committed conformance/ directory
         and the shared-corpus lookup: the infrastructure the law-vector legs read. -->
    <!-- Phase 423: the suite's total column-from-cells builder over Core 1.0.0's `Column.ofCells`. -->
    <Compile Include="KitColumn.fs" />
    <Compile Include="Snapshots.fs" />
    <Compile Include="ChildProcess.fs" />
    <Compile Include="OwnedConformance.fs" />
    <Compile Include="SiblingCorpus.fs" />
    <!-- The law-family roster share this repository ships; early, because the roster, census
         and vacuity checks below read it. -->
    <Compile Include="KitRoster.fs" />
    <!-- Phase 342: the transform vectors' declared sample, and the prepared-result law over it. Both
         Fable-clean; the node benchmark harness compiles them too. -->
    <Compile Include="TransformVectorSample.fs" />
    <Compile Include="PreparedResultLaw.fs" />
    <Compile Include="DataFrameTests.fs" />
    <!-- Phase 626: the ColExpr authoring helpers build exactly the constructors' nodes. -->
    <Compile Include="SyntaxTests.fs" />
    <Compile Include="ConcurrentPipelinesTests.fs" />
    <!-- Phase 375: the step as data, held byte-identical to the sequential member. The law is
         Fable-clean; the node harness under benchmarks/results/ compiles it too. -->
    <Compile Include="MorselHandOffLaw.fs" />
    <Compile Include="MorselHandOffTests.fs" />
    <!-- Phase 376: the worker pool's laws, Fable-clean; the node leg under Node/ compiles them too. -->
    <Compile Include="PooledLaw.fs" />
    <Compile Include="PooledLawTests.fs" />
    <Compile Include="ColumnOpsTests.fs" />
    <Compile Include="DeltaTests.fs" />
    <Compile Include="IncrementalTests.fs" />
    <Compile Include="IncrementalCorpusTests.fs" />
    <Compile Include="ScalingTests.fs" />
    <Compile Include="IncrementalTopNTests.fs" />
    <!-- Phase 269 — the planner, pinned case by case. -->
    <Compile Include="PlanTests.fs" />
    <!-- Phase 277: decimal arithmetic in the evaluator. -->
    <Compile Include="DecimalTests.fs" />
    <Compile Include="DecimalVectorLaw.fs" />
    <Compile Include="DecimalVectorTests.fs" />
    <Compile Include="DateCompareTests.fs" />
    <Compile Include="DecimalStrandTests.fs" />
    <!-- Phase 281: the registered pipeline query. -->
    <Compile Include="PipelineQueryTests.fs" />
    <Compile Include="DeriveTypingTests.fs" />
    <!-- Phase 429: the unit rules, every refusal class, and a go-red per rule. -->
    <Compile Include="UnitPropagationTests.fs" />
    <Compile Include="FunctionsAndCurvesTests.fs" />
    <Compile Include="FitTests.fs" />
    <Compile Include="FitFamiliesTests.fs" />
    <Compile Include="FitGeneralTests.fs" />
    <Compile Include="PredictTests.fs" />
    <!-- Phase 621: the seeded steps, KMeans and Bootstrap, over the pinned generator. -->
    <Compile Include="SeededStepsTests.fs" />
    <Compile Include="IncrementalGroupByTests.fs" />
    <Compile Include="IncrementalRefreshCostTests.fs" />
    <Compile Include="IncrementalStateCodecTests.fs" />
    <Compile Include="IncrementalWindowTests.fs" />
    <Compile Include="PreparedEditRefreshTests.fs" />
    <!-- Phase 250's composition, carried from the substrate's suite by Phase 261: deltaOf,
         changedColumns and the sheet that drives Propagation over Incremental through them. -->
    <Compile Include="PropagationCompositionTests.fs" />
    <!-- Phase 590: the linear-algebra law vectors (Fable-clean; the node leg under LinearAlgebraNode/
         compiles them too) and the suite over the package. Before LawVectorExport.fs, whose emitted
         list names the vector file. -->
    <!-- Phase 630: the elementary vectors and the suite over Fuaran.Compute.Elementary, moved out of the
         linear-algebra files with the module (Fable-clean; the same node leg compiles the vectors). -->
    <Compile Include="ElementaryVectors.fs" />
    <!-- Phase 631: the special functions' vectors, appended to the elementary document (Fable-clean; the
         same node leg compiles them), and the suite over Special. After ElementaryVectors.fs, whose
         cells and head they render through. -->
    <Compile Include="SpecialVectors.fs" />
    <Compile Include="ElementaryTests.fs" />
    <Compile Include="SpecialTests.fs" />
    <Compile Include="LinearAlgebraVectors.fs" />
    <!-- Phase 633: the solver vectors (Fable-clean; the same node leg compiles them). After
         ElementaryVectors.fs, whose float cell they render through; before LinearAlgebraTests.fs, whose
         node leg compares their document. -->
    <Compile Include="SolversVectors.fs" />
    <!-- Phase 632: the regression vectors and the suite over Fuaran.Compute.Regression, moved out of the
         linear-algebra files with the code (Fable-clean; the same node leg compiles the vectors). After
         LinearAlgebraVectors.fs, whose cells they render through; before LinearAlgebraTests.fs, whose node
         leg compares their document. -->
    <Compile Include="RegressionVectors.fs" />
    <!-- Phase 618: the distribution vectors (Fable-clean; the same node leg compiles them). After
         ElementaryVectors.fs, whose float cell they render through; before LinearAlgebraTests.fs, whose
         node leg compares their document. -->
    <Compile Include="DistributionsVectors.fs" />
    <Compile Include="LinearAlgebraTests.fs" />
    <Compile Include="RegressionTests.fs" />
    <!-- Phase 633: the suite over Fuaran.Compute.Solvers. -->
    <Compile Include="SolversTests.fs" />
    <!-- Phase 634: Glm calls the solvers, and answers the bits it answered before. -->
    <Compile Include="GlmSolversTests.fs" />
    <!-- Phase 618: the suite over Fuaran.Compute.Distributions. -->
    <Compile Include="DistributionsTests.fs" />
    <Compile Include="LawVectorExport.fs" />
    <Compile Include="LawVectorTests.fs" />
    <!-- The package roster held to the tree (the README table, the STABILITY.md entry for the
         standing Version, the release tags), and the committed public-surface baseline per
         package under api/, rendered from IL metadata and classified when it moves. -->
    <!-- The families this repository ships, held to its assembly, its census and its reference
         runs. WitnessTaking before Vacuity, which reuses its reference pipelines; after
         LawVectorExport.fs, whose transform sample the census runs. -->
    <Compile Include="ConformanceFamiliesTests.fs" />
    <Compile Include="WitnessTakingFamiliesTests.fs" />
    <Compile Include="SampleAdequacyTests.fs" />
    <Compile Include="ConformanceVacuityTests.fs" />
    <Compile Include="PackageRosterTests.fs" />
    <Compile Include="PublicSurfaceTests.fs" />
    <!-- The compute boundary, held from this side: the substrate by package, and only the four
         packages the strand stands on. After PublicSurfaceTests, whose assembly locator it reuses. -->
    <!-- The committed WIRE-surface baseline per wire-bearing package (api/wire/). Reads
         PublicSurfaceTests.fs and PackageRosterTests.fs, so it follows both. -->
    <Compile Include="WireSurfaceTests.fs" />
    <Compile Include="ComputeBoundaryTests.fs" />
    <!-- The F* oracles as hosts: the extracted ColumnOps and Pipeline models run beside production
         (the Proofs.Oracle family the proof leg's host step runs). -->
    <Compile Include="ProofOracleTests.fs" />
    <!-- The claims ladder held to the tree (Proofs.Ladder). After ProofOracleTests.fs, whose case
         names the ladder reads. -->
    <Compile Include="ProofsLadderTests.fs" />
    <!-- The coverage declaration held to the tree, package by package and operation by operation
         (Proofs.Coverage, Phase 432). After PackageRosterTests.fs, whose roster the package clause
         reads. -->
    <Compile Include="ProofCoverageTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Compute.Solvers\Fuaran.Compute.Solvers.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Compute.Elementary\Fuaran.Compute.Elementary.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Compute.Distributions\Fuaran.Compute.Distributions.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Compute.LinearAlgebra\Fuaran.Compute.LinearAlgebra.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Compute.Regression\Fuaran.Compute.Regression.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Compute.DataFrame\Fuaran.Compute.DataFrame.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Compute.ColumnOps\Fuaran.Compute.ColumnOps.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Compute.Conformance\Fuaran.Compute.Conformance.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Compute.PipelineQuery\Fuaran.Compute.PipelineQuery.fsproj" />
    <!-- The F*-extracted oracle (never packed; see proofs/README.md). -->
    <ProjectReference Include="..\..\proofs\oracle\Fuaran.Core.Compute.Proofs.Oracle.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.Core.Column" />
    <PackageReference Include="Fuaran.Core.Unit" />
    <PackageReference Include="Fuaran.Core.Wire" />
    <PackageReference Include="Fuaran.Core.OpStream" />
    <PackageReference Include="Fuaran.Core.Conformance" />
    <!-- TEST-ONLY: the composition suite drives the substrate's Propagation over a tree edited by
         Ops. No packable project takes these (the Compute boundary tests read src/ only). -->
    <PackageReference Include="Fuaran.Core.Propagation" />
    <PackageReference Include="Fuaran.Core.Ops" />
    <PackageReference Include="Fuaran.Core.Tree" />
    <PackageReference Include="Expecto" />
  </ItemGroup>
</Project>
