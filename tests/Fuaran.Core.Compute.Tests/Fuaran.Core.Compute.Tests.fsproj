<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The repository root, the UTF-8 child-process reader, the committed conformance/ directory
         and the shared-corpus lookup: the infrastructure the law-vector legs read. -->
    <Compile Include="Snapshots.fs" />
    <Compile Include="ChildProcess.fs" />
    <Compile Include="OwnedConformance.fs" />
    <Compile Include="SiblingCorpus.fs" />
    <!-- The law-family roster share this repository ships; early, because the roster, census
         and vacuity checks below read it. -->
    <Compile Include="KitRoster.fs" />
    <Compile Include="DataFrameTests.fs" />
    <Compile Include="ColumnOpsTests.fs" />
    <Compile Include="DeltaTests.fs" />
    <Compile Include="IncrementalTests.fs" />
    <Compile Include="IncrementalCorpusTests.fs" />
    <Compile Include="ScalingTests.fs" />
    <Compile Include="IncrementalTopNTests.fs" />
    <!-- Phase 269 — the planner, pinned case by case. -->
    <Compile Include="PlanTests.fs" />
    <!-- Phase 277: decimal arithmetic in the evaluator. -->
    <Compile Include="DecimalTests.fs" />
    <!-- Phase 281: the registered pipeline query. -->
    <Compile Include="PipelineQueryTests.fs" />
    <Compile Include="IncrementalGroupByTests.fs" />
    <Compile Include="IncrementalRefreshCostTests.fs" />
    <!-- Phase 250's composition, carried from the substrate's suite by Phase 261: deltaOf,
         changedColumns and the sheet that drives Propagation over Incremental through them. -->
    <Compile Include="PropagationCompositionTests.fs" />
    <Compile Include="LawVectorExport.fs" />
    <Compile Include="LawVectorTests.fs" />
    <!-- The package roster held to the tree (the README table, the STABILITY.md entry for the
         standing Version, the release tags), and the committed public-surface baseline per
         package under api/, rendered from IL metadata and classified when it moves. -->
    <!-- The families this repository ships, held to its assembly, its census and its reference
         runs. WitnessTaking before Vacuity, which reuses its reference pipelines; after
         LawVectorExport.fs, whose transform sample the census runs. -->
    <Compile Include="ConformanceFamiliesTests.fs" />
    <Compile Include="WitnessTakingFamiliesTests.fs" />
    <Compile Include="SampleAdequacyTests.fs" />
    <Compile Include="ConformanceVacuityTests.fs" />
    <Compile Include="PackageRosterTests.fs" />
    <Compile Include="PublicSurfaceTests.fs" />
    <!-- The compute boundary, held from this side: the substrate by package, and only the four
         packages the strand stands on. After PublicSurfaceTests, whose assembly locator it reuses. -->
    <!-- The committed WIRE-surface baseline per wire-bearing package (api/wire/). Reads
         PublicSurfaceTests.fs and PackageRosterTests.fs, so it follows both. -->
    <Compile Include="WireSurfaceTests.fs" />
    <Compile Include="ComputeBoundaryTests.fs" />
    <!-- The F* oracles as hosts: the extracted ColumnOps and Pipeline models run beside production
         (the Proofs.Oracle family the proof leg's host step runs). -->
    <Compile Include="ProofOracleTests.fs" />
    <!-- The claims ladder and the coverage declaration held to the tree (Proofs.Ladder,
         Proofs.Coverage). After ProofOracleTests.fs, whose case names the ladder reads, and
         PackageRosterTests.fs, whose roster the coverage rule reads. -->
    <Compile Include="ProofsLadderTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Core.DataFrame\Fuaran.Core.DataFrame.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.Column.Ops\Fuaran.Core.Column.Ops.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.DataFrame.Conformance\Fuaran.Core.DataFrame.Conformance.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Core.DataFrame.PipelineQuery\Fuaran.Core.DataFrame.PipelineQuery.fsproj" />
    <!-- The F*-extracted oracle (never packed; see proofs/README.md). -->
    <ProjectReference Include="..\..\proofs\oracle\Fuaran.Core.Compute.Proofs.Oracle.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.Core.Column" />
    <PackageReference Include="Fuaran.Core.Wire" />
    <PackageReference Include="Fuaran.Core.OpStream" />
    <PackageReference Include="Fuaran.Core.Conformance" />
    <!-- TEST-ONLY: the composition suite drives the substrate's Propagation over a tree edited by
         Ops. No packable project takes these (the Compute boundary tests read src/ only). -->
    <PackageReference Include="Fuaran.Core.Propagation" />
    <PackageReference Include="Fuaran.Core.Ops" />
    <PackageReference Include="Fuaran.Core.Tree" />
    <PackageReference Include="Expecto" />
  </ItemGroup>
</Project>
