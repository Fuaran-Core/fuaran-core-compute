<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Phase 376 — what the worker pool costs and buys: one program, compiled by Fable, that is every
    role at once (the node main program and its workers; in a browser the page, a dedicated worker
    hosting the evaluator, and the pool's workers). Not a member of the solution: the verify gate
    never builds it. See the results file beside this directory for how it was run.

    The assembly takes the test suite's name because it compiles the suite's law file for its tables
    and reads the dataframe package's internal working forms; the package lets that one assembly see
    them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>Fuaran.Core.Compute.Tests</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\tests\Fuaran.Core.Compute.Tests\TransformVectorSample.fs" Link="TransformVectorSample.fs" />
    <Compile Include="..\..\..\tests\Fuaran.Core.Compute.Tests\PreparedResultLaw.fs" Link="PreparedResultLaw.fs" />
    <Compile Include="..\..\..\tests\Fuaran.Core.Compute.Tests\MorselHandOffLaw.fs" Link="MorselHandOffLaw.fs" />
    <Compile Include="PoolBench.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Fuaran.Compute.DataFrame\Fuaran.Compute.DataFrame.fsproj" />
    <ProjectReference Include="..\..\..\src\Fuaran.Compute.Conformance\Fuaran.Compute.Conformance.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
