    { "id": "dot-fma-witness", "op": "dot", "input": { "x": ["3ff0000000000000", "3ff0000000400000"], "y": ["bff0000000800000", "3ff0000000400000"] }, "expected": { "verdict": "ok", "value": "0000000000000000" } },
