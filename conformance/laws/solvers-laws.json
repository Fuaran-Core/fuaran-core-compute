    { "id": "bisect-cubic-relative", "op": "bisect", "input": { "f": "cubic", "rule": { "cap": 100, "test": "relativeChange", "tolerance": "3ddb7cdfd9d7bdbb", "floor": "3fb999999999999a" }, "lo": "4000000000000000", "hi": "4008000000000000" }, "expected": { "verdict": "ok", "state": "4000c1a4350c0000", "value": "3e15c23000000000", "iterations": 33, "arm": "relativeChange" } },
