<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Compute.LinearAlgebra</PackageId>
    <Description>Fuaran.Compute.LinearAlgebra — a small, dense, column-major linear-algebra contract whose every operation runs in one pinned floating-point order, so its answers are byte-identical on .NET, under Fable and in every host that ports it: an opaque immutable Matrix, vectors as Fuaran.Core's Vector&lt;float&gt; (a float column is an input without a copy), the level-1 operations (dot, axpy, scale, add, sub and the scaled norm2), gemv in column-axpy order, gemm in per-element k order, the Gram matrix, triangular solves over a checked UpperTriangular, the one Givens rotation, batch and pivoted Householder factorizations with one rank rule, the bit-pattern wire form of a matrix, typed errors and canonical NaN out. Matrix operations only: regression modelling over them is Fuaran.Compute.Regression. No fused multiply-add and no host mathematics call on any host. Fable-clean.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Types, storage and the internal kernels every module reads. -->
    <Compile Include="Matrix.fs" />
    <!-- Levels 1 to 3. -->
    <Compile Include="Blas.fs" />
    <!-- The checked triangular factor, its solves, and the one Givens rotation. -->
    <Compile Include="Triangular.fs" />
    <!-- The rank rule of D49 item 11, read by the pivoted QR and by Fuaran.Compute.Regression's solve
         (its own file since Phase 632). -->
    <Compile Include="Rank.fs" />
    <!-- The batch and pivoted Householder factorizations (Phase 591). The streaming accumulator and
         least squares are Fuaran.Compute.Regression's since Phase 632 (DECISIONS.md D75). -->
    <Compile Include="QR.fs" />
    <!-- The wire form of a matrix (Phase 591). -->
    <Compile Include="Wire.fs" />
    <!-- Every public operation's exactness class, as data. -->
    <Compile Include="Operations.fs" />
    <!-- The law family over the operations above. LAST: it reads all of them. -->
    <Compile Include="LinearAlgebraLaws.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Vectors are the substrate's `Vector<float>`, and a matrix travels through its canonical JSON
         (DECISIONS.md D49 item 20); nothing else of the substrate is read. Nothing of Compute is
         referenced: the package graph's matrix layer stands alone (Phase 632, DECISIONS.md D75). -->
    <PackageReference Include="Fuaran.Core.Column" />
    <PackageReference Include="Fuaran.Core.Wire" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- The suite holds the native kernels byte-equal to the portable ones. -->
    <InternalsVisibleTo Include="Fuaran.Core.Compute.Tests" />
    <!-- The benchmark harness times the portable rotation against the native one. -->
    <InternalsVisibleTo Include="Fuaran.Core.Compute.Benchmarks.Node" />
    <!-- Phase 632 - regression modelling left this package for its own, and its unchanged bodies read
         the kernels (`Kernels.adopt`, `canonical`, `lend`, `norm2Pair`, `rotateNative`), the rank rule,
         the internal constructors and the bit-pattern spelling of the codec. Granted rather than made
         public, as DataFrame grants ColumnOps and Conformance: no public surface grows to carry a
         kernel no consumer should call (DECISIONS.md D75). -->
    <InternalsVisibleTo Include="Fuaran.Compute.Regression" />
  </ItemGroup>
</Project>
