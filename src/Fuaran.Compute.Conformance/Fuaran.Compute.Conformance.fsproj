<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Compute.Conformance</PackageId>
    <Description>Fuaran.Compute.Conformance — the law families over the dataframe layer, beside the Fuaran.Core.Conformance kit they extend: transform parity against the DataFrame reference evaluator, the columnar op-algebra and op-stream (ColumnOps), incremental evaluation (evalFrom and the IncrementalDelta equivalence family), params and slot params, the static output-schema walk, the pinned evaluation clock, and aggregate-versus-GroupBy parity. The families ship in module DataFrameConformance; the pre-split Conformance.* spellings forward to them (marked for removal in Phase 258). FSharp.Core only, Fable-clean.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The families, in their own module. They read `ConfRng`, `LawResult`, `StreamGen` and the
         adequacy guard from the kit, and nothing private of it. -->
    <Compile Include="DataFrameConformance.fs" />
    <!-- Phase 99 — the incremental-evaluation equivalence family, moved whole in Phase 257 under
         its own module name. -->
    <Compile Include="IncrementalDelta.fs" />
    <!-- The pre-split spellings, forwarding to DataFrameConformance. After it, because each member
         is a call into it. -->
    <Compile Include="Forwards.fs" />
    <!-- Phase 281 - the registered pipeline query's law family, in its own module. Before the
         roster, which enumerates it. -->
    <Compile Include="PipelineQueryLaws.fs" />
    <!-- This package's share of the family roster. LAST, for the reason Families.fs is last in the
         kit: it enumerates the families above as data and depends on none of them. -->
    <Compile Include="DataFrameFamilies.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fuaran.Core.Conformance" />
    <PackageReference Include="Fuaran.Core.Column" />
    <ProjectReference Include="..\Fuaran.Compute.DataFrame\Fuaran.Compute.DataFrame.fsproj" />
    <ProjectReference Include="..\Fuaran.Compute.ColumnOps\Fuaran.Compute.ColumnOps.fsproj" />
    <!-- Phase 281 - the registered pipeline query, whose law family ships here. -->
    <ProjectReference Include="..\Fuaran.Compute.PipelineQuery\Fuaran.Compute.PipelineQuery.fsproj" />
    <PackageReference Include="Fuaran.Core.OpStream" />
    <PackageReference Include="Fuaran.Core.Wire" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
