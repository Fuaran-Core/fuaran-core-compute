<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Core.DataFrame</PackageId>
    <Description>Fuaran.Core.DataFrame — the declarative-compute layer over Fuaran.Core.Column: a serializable dataframe-transform algebra (Transform + ColExpr, full v1 verb set — filter/project/derive/groupBy/join/window/pivot/unpivot/sort/distinct/limit/union), a pure reference evaluator with pinned null/coercion/order/float semantics (the cross-host parity contract), and a canonical wire codec. transformLaws (in Fuaran.Core.Conformance) certifies any host evaluator byte-identical to the reference. Also carries the typed delta representation for the column layer (TableDelta: rows added/changed/removed addressed by a caller-supplied identity witness, column invalidation, and full-refresh as the top element) with an associative composition and a canonical wire codec, and the incremental evaluation seam over it: a pipeline evaluated against a delta rather than from scratch, with per-step incrementality declared as data (propagate / maintain-state / typed fall-back), a measured recompute footprint, and certified equality with the reference evaluator for every (base, delta) pair. FSharp.Core only, Fable-clean.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Phase 267 — the dense columnar frame: the typed vectors, masks and selection the evaluator
         works over. First, because DataFrame.fs evaluates over it. -->
    <Compile Include="Frame.fs" />
    <Compile Include="DataFrame.fs" />
    <!-- Phase 98 — the typed delta representation. After DataFrame.fs: it reads the pinned
         canonical row token and the Phase 34 `Change` it projects to/from. -->
    <Compile Include="Delta.fs" />
    <!-- Phase 99 — the incremental evaluation seam. After Delta.fs (it consumes `TableDelta` and
         `RowIdentity`) and after DataFrame.fs (it calls the reference evaluator's exposed
         primitives, and degrades to the reference evaluator itself). -->
    <Compile Include="Incremental.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Phase 266 — the suite holds the compiled expression form to the reference evaluator over
         generated triples and checks that its sample reached every typed kernel; the compiler, its
         typer and the kernel census are internal (this repository's working forms, not a contract),
         so the test assembly is the one assembly that may see them. No public surface moves. -->
    <InternalsVisibleTo Include="Fuaran.Core.Compute.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fuaran.Core.Column" />
    <PackageReference Include="Fuaran.Core.Wire" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
