<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Compute.Distributions</PackageId>
    <Description>Fuaran.Compute.Distributions — pinned probability distributions: the cumulative distribution function and the quantile of the standard normal, Student's t, the chi-square and Fisher's F distributions, each written with + − × ÷, the correctly rounded square root and the pinned special functions of Fuaran.Compute.Elementary alone, in one order, so their answers are byte-identical on .NET, under Fable and in every host that transcribes them. The one iteration, the chi-square quantile, is the pinned bracketed Newton of Fuaran.Compute.Solvers under a stated stopping rule. No fused multiply-add and no host mathematics call on any host. FSharp.Core, Fuaran.Compute.Solvers and Fuaran.Compute.Elementary only; Fable-clean.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The four families, one module each: Normal, StudentT, ChiSquare, FisherF (Phase 618,
         DECISIONS.md D79). -->
    <Compile Include="Distributions.fs" />
    <!-- Every public operation's exactness class, as data. -->
    <Compile Include="DistributionsOperations.fs" />
    <!-- The law family over the operations above. LAST: it reads all of them. -->
    <Compile Include="DistributionsLaws.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The special functions the distributions are written over, and the solver the chi-square quantile
         calls (DECISIONS.md D77, D78, D79). Nothing else of Compute, nothing of the substrate. -->
    <ProjectReference Include="..\Fuaran.Compute.Solvers\Fuaran.Compute.Solvers.fsproj" />
    <ProjectReference Include="..\Fuaran.Compute.Elementary\Fuaran.Compute.Elementary.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
