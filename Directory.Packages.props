<Project>
  <PropertyGroup>
    <!-- ONE property for every Fuaran.Core package this repository pins: they are produced by one
         repository at one version, so one number is the only honest way to name them. Raise it in
         one edit, and only to a version the public registry serves. -->
    <FuaranCoreVersion>0.35.1</FuaranCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="10.1.300" />
    <!-- The substrate, by package. The compute strand stands on Column and Wire, records its edits
         through OpStream and extends the Conformance kit — and on nothing above those four (the
         boundary test in tests/ holds that). -->
    <PackageVersion Include="Fuaran.Core.Column" Version="$(FuaranCoreVersion)" />
    <PackageVersion Include="Fuaran.Core.Wire" Version="$(FuaranCoreVersion)" />
    <PackageVersion Include="Fuaran.Core.OpStream" Version="$(FuaranCoreVersion)" />
    <PackageVersion Include="Fuaran.Core.Conformance" Version="$(FuaranCoreVersion)" />
    <!-- Phase 281: the registered pipeline query pairs the substrate's Query declaration with a
         pipeline; only Fuaran.Compute.PipelineQuery takes it. -->
    <PackageVersion Include="Fuaran.Core.Query" Version="$(FuaranCoreVersion)" />
    <!-- TEST-ONLY. -->
    <!-- The composition suite's substrate (tests/ only): Propagation over a tree edited by Ops. -->
    <PackageVersion Include="Fuaran.Core.Propagation" Version="$(FuaranCoreVersion)" />
    <PackageVersion Include="Fuaran.Core.Ops" Version="$(FuaranCoreVersion)" />
    <PackageVersion Include="Fuaran.Core.Tree" Version="$(FuaranCoreVersion)" />
    <PackageVersion Include="Expecto" Version="9.0.4" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" /><!-- BENCHMARK-ONLY: benchmarks/, not packable. -->
  </ItemGroup>
</Project>
