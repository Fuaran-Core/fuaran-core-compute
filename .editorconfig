root = true

# Line endings are LF everywhere — on disk as well as in the index.
#
# `.gitattributes` pins `* text=auto eol=lf`, which makes a CHECKOUT LF. It does not keep the
# working copy that way: Fantomas resolves its output line ending from EditorConfig and falls back
# to the platform's, so a format run on Windows would rewrite every `.fs` file to CRLF — a tree that
# `git status` calls dirty while `git diff` calls clean. This setting stops that drift at its source.
#
# Deliberately just the one setting. Fantomas reads this file, so every key added here is a
# formatting decision for the whole repository; the formatting profile is its defaults and this
# changes none of it.
[*]
end_of_line = lf
